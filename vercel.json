{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/js/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/pics/(.*)",
      "headers": { "cache-control": "no-cache" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "/$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}